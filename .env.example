# Copia este archivo a .env.local y rellena los valores reales.
# Nunca commitees .env.local ni ningún valor real de este archivo.

# ---------------------------------------------------------------------------
# Públicas (expuestas al navegador, prefijo NEXT_PUBLIC_ obligatorio)
# ---------------------------------------------------------------------------

# URL del proyecto de Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (pública) del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL base de la app (usada en enlaces absolutos, ej. emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL de callback de Supabase Auth para desarrollo local
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# ---------------------------------------------------------------------------
# Servidor (nunca expuestas al navegador)
# ---------------------------------------------------------------------------

# Service role key de Supabase (bypassa RLS). Usar solo en server/admin client.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido para autorizar llamadas a los endpoints de cron (bank-sync).
CRON_SECRET=

# API key de Resend para el envío de emails (avisos y tareas) y para descargar
# los correos que llegan al buzón de facturas.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Buzón de facturas por delegación + lectura automática con IA
# (docs/FACTURAS_EMAIL_IA.md)
# ---------------------------------------------------------------------------

# Secreto del webhook de Resend (whsec_...), en Webhooks → tu endpoint.
# Sin él, POST /api/facturas/entrantes rechaza todo: no hay firma que comprobar.
RESEND_WEBHOOK_SECRET=

# Dirección base del buzón. La delegación va en la etiqueta:
# facturas+castellon@movimientoconsolacion.com. Es NEXT_PUBLIC_ porque la
# app la enseña en la bandeja para que cada tesorero sepa la suya.
NEXT_PUBLIC_FACTURAS_EMAIL=facturas@movimientoconsolacion.com
# Solo si el buzón no se llama "facturas" (debe coincidir con lo anterior).
FACTURAS_EMAIL_LOCAL=facturas

# Clave de la API de Gemini (https://aistudio.google.com/apikey) para leer las
# facturas. Sin ella todo lo demás sigue funcionando: las facturas entran, pero
# hay que rellenarlas a mano.
GEMINI_API_KEY=
# Modelo y esfuerzo de razonamiento. Los valores por defecto son los buenos:
# gemini-3.7-flash lee facturas de sobra y "low" es el más rápido y barato.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low

# ---------------------------------------------------------------------------
# API externa y servidor MCP
# (docs/manual/21.-api-externa-solo-pros.md y 22.-servidor-mcp.md;
#  prueba rápida en docs/API_PRUEBA_RAPIDA.md)
# ---------------------------------------------------------------------------

# Clave con permiso de LECTURA Y ESCRITURA. Es la que necesita el servidor MCP
# para crear avisos, subir facturas o conciliar. Sin ella, la API funciona en
# modo consulta con CRON_SECRET y toda escritura devuelve 403.
MCM_API_KEY=

# Clave alternativa de SOLO LECTURA, para integraciones que únicamente
# consultan (informes, cuadros de mando, Google Apps Script). Opcional, pero
# recomendable: así una clave pegada en una hoja de cálculo no puede modificar
# la contabilidad.
MCM_API_KEY_READONLY=

# Usuario de MCM Bank al que se atribuyen las escrituras hechas por la API
# cuando quien llama no indica la suya (cabecera x-mcm-usuario-email o campo
# usuario_email). Sin esto, las escrituras fallan con un mensaje explicándolo:
# es deliberado, para no firmar notas con la persona equivocada.
MCM_API_USER_EMAIL=
# Alternativa al correo, con el UUID del usuario.
MCM_API_USER_ID=

# ---------------------------------------------------------------------------
# Enable Banking (sincronización bancaria PSD2) — ver docs/ENABLE_BANKING.md
# ---------------------------------------------------------------------------

ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_PSU_IP=
ENABLE_BANKING_PSU_UA=
ENABLE_BANKING_REDIRECT_URL=

# ---------------------------------------------------------------------------
# Integración con Google (Drive/Docs para memorias económicas)
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Clave hex de 64 caracteres (32 bytes) para cifrar los tokens de Google guardados.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Opcional: ID de la plantilla de Google Docs para memorias económicas.
GOOGLE_MEMORIA_TEMPLATE_ID=
